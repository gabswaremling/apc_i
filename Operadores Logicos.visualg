algoritmo "operadores_logicos"

var
   idade: inteiro
   maioridadeCivil: inteiro
   maioridadePenal: inteiro

inicio

   idade <- 18
   maioridadeCivil <- 21
   maioridadePenal <- 18

   // Comparando com ambas as idades (Civil e Penal)
   escreval("É maior das duas idades? ", (idade >= maioridadePenal) E (idade >= maioridadeCivil))
   escreval("É maior de alguma idade? ", (idade >= maioridadePenal) OU (idade >= maioridadeCivil))
   escreval("É menor de idade para ambas? ", (idade < maioridadePenal) E (idade < maioridadeCivil))

fimalgoritmo